# Database - Using PostgreSQL (for Railway deployment)
# For local development, use: postgresql://postgres:password@localhost:5432/myclean?schema=public
# For Railway, this will be automatically set by Railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/myclean?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT Secret
JWT_SECRET="dev-secret-key-change-in-production-12345678"

# CORS Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://myclean-project.vercel.app"

# ========== EMAIL CONFIGURATION ==========
# Enable email sending (set to true for production)
EMAIL_ENABLED=true

# SMTP Configuration (for Gmail, Outlook, or custom SMTP)
# Example for Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate an app-specific password
# 3. Use that password here (NOT your regular Gmail password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
EMAIL_FROM="MyClean <noreply@myclean.app>"

# Email Queue Settings (optional, defaults are fine)
EMAIL_QUEUE_MAX_ATTEMPTS=4
EMAIL_QUEUE_BATCH_SIZE=20
EMAIL_QUEUE_INTERVAL_MS=15000
EMAIL_QUEUE_RETRY_MINUTES=5,15,60
# Set to true to disable email queue worker (useful for testing)
DISABLE_EMAIL_QUEUE=false

# ========== APPLICATION SETTINGS ==========
# Base URL for your application (used in email links)
APP_BASE_URL="https://myclean-project.vercel.app"
BRAND_NAME="MyClean"
SUPPORT_EMAIL="support@myclean.app"
APP_TIMEZONE="America/New_York"
APP_CURRENCY="USD"

# ========== PAYMENT SETTINGS ==========
# Stripe Configuration (optional for local dev)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ========== FILE STORAGE ==========
# AWS S3 / Cloudinary (optional for local dev)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
