# Database
# IMPORTANT: The schema.prisma is configured for PostgreSQL
# For production deployments, use PostgreSQL connection string:
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# For local development with PostgreSQL (recommended):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/myclean?schema=public"

# For local development with SQLite (optional):
# 1. Change schema.prisma provider from "postgresql" to "sqlite"
# 2. Change migration_lock.toml provider from "postgresql" to "sqlite"
# 3. Use: DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=4000
NODE_ENV=development

# JWT Secret (use a strong random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,https://your-frontend-url.vercel.app"
