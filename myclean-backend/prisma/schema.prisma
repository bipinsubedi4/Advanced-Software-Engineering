datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PublicJobStatus {
  BIDDING
  CLOSED
}

enum PublicJobBidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RecurringFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum EmailTemplate {
  WELCOME
  BOOKING_CONFIRM_CUSTOMER
  BOOKING_CONFIRM_PROVIDER
  BOOKING_REMINDER_CUSTOMER
  BOOKING_REMINDER_PROVIDER
  BOOKING_RECEIPT_CUSTOMER
  PAYMENT_REMINDER_CUSTOMER
  PAYMENT_RECEIVED_PROVIDER
}

// User model - for both customers and providers
model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String
  passwordHash      String
  role              String             @default("CUSTOMER") // CUSTOMER | PROVIDER | ADMIN
  hasCustomerAccount Boolean           @default(false)
  hasProviderAccount Boolean           @default(false)
  isSuspended       Boolean            @default(false)
  phone             String?
  profileImage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Relations
  customerBookings  Booking[]          @relation("CustomerBookings")
  providerBookings  Booking[]          @relation("ProviderBookings")
  providerProfile   ProviderProfile?
  reviews           Review[]
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  notifications     Notification[]
  cleanerRatingsReceived CleanerRating[] @relation("CleanerRatingsProvider")
  cleanerRatingsGiven CleanerRating[]    @relation("CleanerRatingsCustomer")
  publicJobs        PublicJob[]        @relation("ClientPublicJobs")
  publicJobBids     PublicJobBid[]
  availabilityBlocks CleanerAvailability[]
  recurringJobsCustomer RecurringJob[] @relation("RecurringCustomer")
  recurringJobsProvider RecurringJob[] @relation("RecurringProvider")
}

// Provider-specific information
model ProviderProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  bio               String?
  yearsExperience   String?
  hasInsurance      Boolean   @default(false)
  hasVehicle        Boolean   @default(false)
  hasEquipment      Boolean   @default(false)
  certifications    String?
  address           String?  // Deprecated - kept for migration
  city              String?  // Deprecated - kept for migration
  state             String?  // Deprecated - kept for migration
  zipCode           String?  // Deprecated - kept for migration
  latitude          Float?   // Deprecated - kept for migration
  longitude         Float?   // Deprecated - kept for migration
  serviceRadius     Int       @default(10) // Deprecated - kept for migration
  servicePostcodes  String[]  @default([]) // Deprecated - replaced by serviceSuburbs
  serviceSuburbs    String[]  @default([]) // New: Array of "Suburb (Postcode)" where cleaner provides service
  isVerified        Boolean   @default(true)
  isActive          Boolean   @default(true)
  isProfileComplete Boolean   @default(false) @map("profileComplete")
  averageRating     Float     @default(0)
  totalReviews      Int       @default(0)
  totalBookings     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  insuranceProvider String?
  stripeAccountId   String?
  stripeChargesEnabledAt DateTime?
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verificationDocumentUrl String?
  verificationSubmittedAt DateTime?
  verificationReviewedAt DateTime?

  
  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          ProviderService[]
  availability      ProviderAvailability[]
  blockedDates      ProviderBlockedDate[]
}

// Services offered by providers
model ProviderService {
  id              Int             @id @default(autoincrement())
  providerId      Int
  serviceName     String
  description     String?
  pricePerHour    Int             // in cents
  durationMin     Int             // minimum duration in minutes
  isActive        Boolean         @default(true)
  status          ServiceStatus   @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  recurringJobs   RecurringJob[]

  @@index([status])
}

// Provider availability schedule
model ProviderAvailability {
  id          Int             @id @default(autoincrement())
  providerId  Int
  dayOfWeek   String          // MONDAY, TUESDAY, etc.
  startTime   String          // HH:MM format
  endTime     String          // HH:MM format
  isAvailable Boolean         @default(true)

  // Relations
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ProviderBlockedDate {
  id         Int              @id @default(autoincrement())
  providerId Int
  date       DateTime
  reason     String?

  provider   ProviderProfile  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, date], name: "idx_provider_blocked_date")
}

// Bookings between customers and providers
model Booking {
  id                Int              @id @default(autoincrement())
  customerId        Int
  providerId        Int
  serviceId         Int
  bookingDate       DateTime
  startTime         String           // HH:MM format
  endTime           String           // HH:MM format
  address           String
  city              String
  state             String
  zipCode           String
  specialInstructions String?
  status            String           @default("PENDING") // PENDING, ACCEPTED, DECLINED, COMPLETED, RATED, CANCELLED
  totalPrice        Int              // in cents
  paymentStatus     String           @default("PENDING") // PENDING, PAID, REFUNDED
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  customer          User             @relation("CustomerBookings", fields: [customerId], references: [id])
  provider          User             @relation("ProviderBookings", fields: [providerId], references: [id])
  service           ProviderService  @relation(fields: [serviceId], references: [id])
  review            Review?
  cleanerRating     CleanerRating?
  messages          Message[]
  publicJob         PublicJob?       @relation("PublicJobBooking", fields: [publicJobId], references: [id])
  publicJobId       Int?
  paymentIntentId   String?
  paymentCaptured   Boolean          @default(false)
  recurringJob      RecurringJob?    @relation("RecurringJobBookings", fields: [recurringJobId], references: [id])
  recurringJobId    Int?
}

// Reviews and ratings
model Review {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @unique
  customerId  Int
  rating      Int      // 1-5 stars
  comment     String?
  photos      String?  // JSON array of photo URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer    User     @relation(fields: [customerId], references: [id])
}

// Notifications for users
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // BOOKING_REQUEST, BOOKING_ACCEPTED, BOOKING_DECLINED, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // URL to relevant page
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// In-app messaging
model Message {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  senderId   Int
  receiverId Int
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  // Relations
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model CleanerRating {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @unique
  cleanerId   Int
  customerId  Int
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner     User     @relation("CleanerRatingsProvider", fields: [cleanerId], references: [id], onDelete: Cascade)
  customer    User     @relation("CleanerRatingsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
}

model PublicJob {
  id           Int              @id @default(autoincrement())
  clientId     Int
  title        String
  description  String
  serviceType  String
  preferredDate DateTime?
  preferredStartTime String?
  preferredEndTime   String?
  city         String
  state        String
  postalCode   String
  budgetMin    Int?
  budgetMax    Int?
  status       PublicJobStatus  @default(BIDDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  client       User             @relation("ClientPublicJobs", fields: [clientId], references: [id], onDelete: Cascade)
  bids         PublicJobBid[]
  bookings     Booking[]         @relation("PublicJobBooking")
}

model PublicJobBid {
  id           Int                @id @default(autoincrement())
  publicJobId  Int
  cleanerId    Int
  message      String?
  proposedPrice Int?
  status       PublicJobBidStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  publicJob    PublicJob          @relation(fields: [publicJobId], references: [id], onDelete: Cascade)
  cleaner      User               @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
}

model RecurringJob {
  id           Int               @id @default(autoincrement())
  customerId   Int
  providerId   Int
  serviceId    Int
  frequency    RecurringFrequency
  startDate    DateTime
  endDate      DateTime?
  timezone     String             @default("UTC")
  notes        String?
  nextOccurrence DateTime?
  isActive     Boolean            @default(true)
  startTime    String
  endTime      String
  address      String
  city         String
  state        String
  zipCode      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  customer     User               @relation("RecurringCustomer", fields: [customerId], references: [id])
  provider     User               @relation("RecurringProvider", fields: [providerId], references: [id])
  service      ProviderService    @relation(fields: [serviceId], references: [id])
  bookings     Booking[]          @relation("RecurringJobBookings")
}

model CleanerAvailability {
  id         Int      @id @default(autoincrement())
  cleanerId  Int
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cleaner    User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId, dayOfWeek])
}

model EmailJob {
  id           Int            @id @default(autoincrement())
  to           String
  subject      String
  template     EmailTemplate
  payload      Json
  status       EmailJobStatus @default(PENDING)
  attemptCount Int            @default(0)
  maxAttempts  Int            @default(3)
  lastError    String?
  scheduledFor DateTime       @default(now())
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}
enum ServiceStatus {
  PENDING
  APPROVED
  REJECTED
}
